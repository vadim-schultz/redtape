# Copy to `.env` and fill in values. See `docs/planning/02-incremental-mvp-roadmap.md` (Wave 1 B3).
#
# Not needed for local dev — DATABASE_URL defaults to local Postgres
# (see docs/operations/local-development.md). Only set this to point at
# Supabase instead.
#
# Tests need Postgres too (JSONB/ARRAY/native enum are Postgres-only): start
# it with `docker compose up -d --wait db`, then `pytest` from apps/api. If
# it's unreachable, DB-backed tests skip with a reason locally; set
# REQUIRE_DB=1 (always set in CI, and by ./ci.sh) to fail instead of skip.

# --- PostgreSQL / Supabase ---
# Dashboard gives: postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
# For SQLAlchemy + psycopg3 use driver prefix: postgresql+psycopg://
# Add TLS if not already in the URL: ?sslmode=require
#
# IPv6 vs IPv4: direct `db.*.supabase.co:5432` may be "Not IPv4 compatible" in the dashboard.
# If you are on an IPv4-only network (common), use the Session pooler URI instead (same dashboard):
#   host: aws-0-<region>.pooler.supabase.com, port 6543, user often postgres.<PROJECT_REF>
# Example (replace region, ref, password):
# DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct DB (IPv6-oriented; only if your network reaches IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require

DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Comma-separated browser origins allowed to call the API (dev + prod)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production example (Cloudflare Pages/Workers):
#   Replace with your frontend origin if different from:
#   https://redtape-web.vadim-schultz.workers.dev
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://redtape-web.vadim-schultz.workers.dev

# Optional (Supabase Auth). Leave unset and auth stays off: protected routes
# behave as today until both the JWKS URL and issuer are set (see chapter 4).
#
# Derive both from the project ref (same <ref> as in DATABASE_URL above):
#   SUPABASE_JWKS_URL=https://<project_ref>.supabase.co/auth/v1/.well-known/jwks.json
#   SUPABASE_JWT_ISSUER=https://<project_ref>.supabase.co/auth/v1
# SUPABASE_JWT_AUDIENCE defaults to `authenticated` (Supabase's default claim); override only if you changed it.
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
