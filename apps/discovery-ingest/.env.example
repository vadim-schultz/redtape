# Copy to `.env` for local discovery-ingest CLI runs.
# API host root only — discovery_ingest appends /api/v1/discovery/machine/...

DISCOVERY_API_URL=http://localhost:8000
DISCOVERY_API_KEY=rt_replace_me

# Optional overrides (defaults in discovery_ingest/config.py)
# GOVDATA_CKAN_BASE_URL=https://ckan.govdata.de/api/3/action
# PVOG_API_BASE_URL=https://pvog.fitko.net/suchdienst/api
# FIM_PORTAL_BASE_URL=https://fimportal.de
# BOT_CONTACT_URL=https://github.com/vadim-schultz/redtape
