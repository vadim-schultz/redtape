# Copy to `.env` for local discovery-ingest CLI runs.
# API host root only — discovery_ingest appends /api/v1/discovery/machine/...

DISCOVERY_API_URL=http://localhost:8000
DISCOVERY_API_KEY=rt_replace_me

# Optional overrides (defaults in discovery_ingest/config.py)
# GOVDATA_CKAN_BASE_URL=https://ckan.govdata.de/api/3/action
# PVOG_API_BASE_URL=https://pvog.fitko.net/suchdienst/api
# FIM_PORTAL_BASE_URL=https://fimportal.de
# BOT_CONTACT_URL=https://github.com/vadim-schultz/redtape

# Cloudflare Browser Run (only for `browser probe` and the render_page / capture_screenshot kinds).
# A custom token with only "Browser Run - Edit"; never commit real values.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BROWSER_API_TOKEN=
# BROWSER_MIN_INTERVAL_SECONDS=11
# BROWSER_REQUEST_TIMEOUT_SECONDS=60

# Cloudflare Workers AI (only for `llm probe` and the llm_extract kind). A custom token with only the Workers AI
# permission, next to CLOUDFLARE_ACCOUNT_ID above; never commit real values.
# CLOUDFLARE_AI_API_TOKEN=
# LLM_MODEL=@cf/qwen/qwen3-30b-a3b-fp8  (the default: the provisional choice for decision X16; empty means no model)
# LLM_ENQUEUE=false  (true: a render drain also enqueues llm_extract for each snapshot; needs a non-empty LLM_MODEL)
# LLM_MAX_TOKENS=4000
# LLM_INPUT_CHARS=30000
# LLM_REQUEST_TIMEOUT_SECONDS=60

# Workers AI embeddings (only for `embed probe` and the embedding drain). Same credentials as above.
# EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b  (the default; must match the API's EMBEDDING_MODEL)

# Claude Code (only for TRANSLATION_ENGINE=claude-code: the translate drain on the Claude Code allowance). No key is
# read: the local `claude` login is used (`claude auth status`), and ANTHROPIC_API_KEY is never passed to the CLI.
# CLAUDE_TRANSLATE_MODEL=claude-sonnet-5-5  (the default)

# Azure AI Translator (only for TRANSLATION_ENGINE=azure-translator: the translate drain on the Azure character ledger).
# The key of the Translator resource and its region are required; the endpoint and API version have defaults. The
# values are never committed; in CI they come from GitHub Actions secrets.
# AZURE_TRANSLATOR_KEY=
# AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com  (the default; a custom domain is the operator's choice)
# AZURE_TRANSLATOR_API_VERSION=2026-06-06  (the default)
