{
  "name": "redtape-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Must run for every request, not just `/api/*`: the Worker also inlines
    // runtime config (Supabase URL/key) into HTML responses (worker/runtimeEnv.ts).
    // Scoping this to `/api/*` only means non-API paths never invoke `fetch()` at
    // all — Cloudflare serves them straight from the assets layer instead.
    "run_worker_first": true
  },
  "vars": {
    "API_ORIGIN": "https://redtape-api.onrender.com",
    "VITE_SUPABASE_URL": "https://agpwiarztdmqhphxkjug.supabase.co",
    "VITE_SUPABASE_ANON_KEY": "sb_publishable_idAzyQ5_uE557a9__k_Dtw_QZavYpCw"
  },
  // `wrangler preview` requires a preview value for every production var.
  "previews": {
    "vars": {
      "API_ORIGIN": "https://redtape-api.onrender.com",
      "VITE_SUPABASE_URL": "https://agpwiarztdmqhphxkjug.supabase.co",
      "VITE_SUPABASE_ANON_KEY": "sb_publishable_idAzyQ5_uE557a9__k_Dtw_QZavYpCw"
    }
  }
}
