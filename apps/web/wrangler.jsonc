{
  "name": "redtape-web",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "VITE_API_URL": "https://redtape-api.onrender.com"
  },
  // `wrangler preview` requires a preview value for every production var.
  "previews": {
    "vars": {
      "VITE_API_URL": "https://redtape-api.onrender.com"
    }
  }
}
