{
  "name": "redtape-web",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://redtape-api.onrender.com"
  },
  // `wrangler preview` requires a preview value for every production var.
  "previews": {
    "vars": {
      "API_ORIGIN": "https://redtape-api.onrender.com"
    }
  }
}
