/**
 * DRAFT — Wave 0 placeholder (not compiled by a Vite app yet).
 *
 * Full implementation: Wave 2 step W2 per docs/planning/02-incremental-mvp-roadmap.md
 * Pattern: DB-backed bundles via GET /api/v1/translations + Accept-Language on API calls.
 *
 * ```tsx
 * import React, { createContext, useCallback, useContext, useEffect, useMemo, useState } from "react";
 *
 * type TranslationBundle = Record<string, string>;
 *
 * type LocaleContextValue = {
 *   locale: string;
 *   setLocale: (next: string) => void;
 *   t: (key: string, params?: Record<string, string | number>) => string;
 *   isLoading: boolean;
 * };
 *
 * const LocaleContext = createContext<LocaleContextValue | undefined>(undefined);
 *
 * const API_BASE = import.meta.env.VITE_API_URL ?? "http://localhost:8000";
 *
 * export function LocaleProvider({ children }: { children: React.ReactNode }) {
 *   const [locale, setLocaleState] = useState<string>(() => {
 *     return window.localStorage.getItem("locale") ?? navigator.language.slice(0, 2) ?? "de";
 *   });
 *   const [translations, setTranslations] = useState<TranslationBundle>({});
 *   const [isLoading, setIsLoading] = useState(true);
 *
 *   useEffect(() => {
 *     let cancelled = false;
 *     (async () => {
 *       setIsLoading(true);
 *       const res = await fetch(`${API_BASE}/api/v1/translations?locale=${encodeURIComponent(locale)}`, {
 *         headers: { "Accept-Language": locale },
 *       });
 *       const data = (await res.json()) as { locale: string; translations: TranslationBundle };
 *       if (!cancelled) {
 *         setTranslations(data.translations);
 *       }
 *       setIsLoading(false);
 *     })();
 *     return () => {
 *       cancelled = true;
 *     };
 *   }, [locale]);
 *
 *   const setLocale = useCallback((next: string) => {
 *     window.localStorage.setItem("locale", next);
 *     setLocaleState(next);
 *     // Wave 2: also update shared fetch client default Accept-Language + invalidate graph queries.
 *   }, []);
 *
 *   const t = useCallback(
 *     (key: string, params?: Record<string, string | number>) => {
 *       let value = translations[key] ?? key;
 *       if (params) {
 *         for (const [k, v] of Object.entries(params)) {
 *           value = value.replaceAll(`{${k}}`, String(v));
 *         }
 *       }
 *       return value;
 *     },
 *     [translations],
 *   );
 *
 *   const value = useMemo(
 *     () => ({ locale, setLocale, t, isLoading }),
 *     [locale, setLocale, t, isLoading],
 *   );
 *
 *   return <LocaleContext.Provider value={value}>{children}</LocaleContext.Provider>;
 * }
 *
 * export function useLocale(): LocaleContextValue {
 *   const ctx = useContext(LocaleContext);
 *   if (!ctx) throw new Error("useLocale must be used within LocaleProvider");
 *   return ctx;
 * }
 * ```
 */

export {};
