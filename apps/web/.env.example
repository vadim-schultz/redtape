# Optional override for `npm run dev` (default is http://localhost:8000 via apiOrigin).
VITE_API_URL=http://localhost:8000
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Do not set VITE_API_URL in .env.production — deployed builds use same-origin
# /api on the Workers host. Render is reached via the Worker (API_ORIGIN).

# Optional (Supabase Auth). Leave both unset and the session gateway reports
# "unconfigured": no login, app behaves as today.
#   VITE_SUPABASE_URL=https://<project_ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY=<anon key>
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
